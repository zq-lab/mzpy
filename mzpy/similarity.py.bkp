@njit(parallel=True)
def batch_compute_similarity(que_list, ref_list=None, tol=(0.003, 0.005)):  
    """  
    计算que_list和ref_list所有MS图谱对的相似度。  
    输入:  
        que_list: ndarray (n1, m, 2)  
        ref_list: ndarray (n2, m, 2) 或空（None或shape[0]==0）  
        tol: (precursor_tol, fragment_tol) 容差  

    输出:  
        ndarray (num_pairs, 6)，列为：  
        [que_idx, ref_idx, matched_count, bonanza, modified_dot, cosine]  
    
    逻辑：  
    - 如果ref_list为空，计算que_list所有两两组合(i<=j),  
    结果行数为 n1*(n1+1)//2，i==j时分数特判为(峰数len, 1,1,1)  
    - 否则计算所有(que_i, ref_j)对，总共n1*n2行  
    """  

    n1 = que_list.shape[0]  

    if (ref_list is None) or (ref_list.shape[0] == 0):  
        # 只计算que_list内部两两组合，i<=j  
        num_pairs = n1 * (n1 + 1) // 2  
        result = np.zeros((num_pairs, 6), dtype=np.float64)  
        idx = 0  
        for i in prange(n1):  
            que_i = que_list[i]  
            # 自身对角线直接赋值最大匹配数和1分数  
            # 峰数假设为que_i.shape[0] - 1 (碎片峰数)  
            matched_count_self = que_i.shape[0] - 1  
            bonanza_self = 1.0  
            modified_dot_self = 1.0  
            cosine_self = 1.0  
            for j in range(i, n1):  
                if i == j:  
                    # 自身对比  
                    result[idx, 0] = i  
                    result[idx, 1] = j  
                    result[idx, 2] = matched_count_self  
                    result[idx, 3] = bonanza_self  
                    result[idx, 4] = modified_dot_self  
                    result[idx, 5] = cosine_self  
                else:  
                    ref_j = que_list[j]  
                    matched_count, bonanza, modified_dot, cosine = get_scores(que_i, ref_j, tol)  
                    result[idx, 0] = i  
                    result[idx, 1] = j  
                    result[idx, 2] = matched_count  
                    result[idx, 3] = bonanza  
                    result[idx, 4] = modified_dot  
                    result[idx, 5] = cosine  
                idx += 1  
        return result  
    else:  
        # 计算que_list与ref_list所有两两组合  
        n2 = ref_list.shape[0]  
        num_pairs = n1 * n2  
        result = np.zeros((num_pairs, 6), dtype=np.float64)  
        for i in prange(n1):  
            que_i = que_list[i]  
            for j in range(n2):  
                ref_j = ref_list[j]  
                matched_count, bonanza, modified_dot, cosine = get_scores(que_i, ref_j, tol)  
                idx = i * n2 + j  
                result[idx, 0] = i  
                result[idx, 1] = j  
                result[idx, 2] = matched_count  
                result[idx, 3] = bonanza  
                result[idx, 4] = modified_dot  
                result[idx, 5] = cosine  
        return result  



def get_dot_product(que, ref, tol=0.005, mass_begin=100, mass_end=1000):  
    """  
    ! 总是返回0!
    计算两个MS/MS图谱之间的相似度，使用点积相似度方法。 
    算法原理: 使用点积相似度方法，通过测量实验和理论质谱之间的协方差来计算相似度
        根据设定的质量容忍度对质谱数据进行聚合，并考虑峰计数惩罚因子，以防止过多量化未观察到的峰。
        适用于高分辨率的质谱数据分析，尤其是需要精确控制相似度计算条件的情况，比如样本瞄准。

    优点：
        核心基于点积和协方差的计算，给出了分数与峰强度的直接关系。
        可以调整质量窗口，以适应不同分辨率的质谱数据。
    缺点：
        对弱峰的响应可能不敏感，尤其在低浓度情况时可能导致相似度过低。
        需要处理峰计数惩罚因子时会增加复杂性。  

    参数:  
        que (list of list of float): 第一个质谱（实验获得的MS/MS图谱），每个元素为[m/z, 强度]。  
        ref (list of list of float): 第二个质谱（理论上的MS/MS图谱），每个元素为[m/z, 强度]。  
        tol (float): 用于合并强度的质量窗口大小, uhnit Da
        mass_begin (float): 进行计算的质量范围起始值。  
        mass_end (float): 进行计算的质量范围结束值。  

    返回:  
        float: 归一化的相似度得分，范围从0（没有相似性）到1（完全一致）。  
    """  

    scalar_m = 0  
    scalar_r = 0  
    covariance = 0  
    sum_m = 0  
    sum_r = 0  

    if (len(que) == 0) or (len(ref)==0) or (que is None) or (ref is None):  
        return 0  # 如果任何一个质谱为空，返回0相似度  

    min_mz = min(que[0][0], ref[0][0])  # 获取最小m/z值  
    max_mz = max(que[-1][0], ref[-1][0])  # 获取最大m/z值  

    # 限制m/z范围在给定的起始和结束值之间  
    if mass_begin > min_mz:  
        min_mz = mass_begin  
    if max_mz > mass_end:  
        max_mz = mass_end  

    focused_mz = min_mz  # 聚焦的m/z值  
    measured_mass_list = []  # 存储归一化后的实验质谱数据  
    reference_mass_list = []  # 存储归一化后的理论质谱数据  

    base_m = float('-inf')  # 实验质量的基准  
    base_r = float('-inf')  # 理论质量的基准  
    remaind_index_m = 0  # 实验质谱的索引  
    remaind_index_l = 0  # 理论质谱的索引  

    # 循环计算在指定质量范围内的强度  
    while focused_mz <= max_mz:  
        # 计算实验质谱在当前m/z范围内的强度  
        sum_m = 0  
        for i in range(remaind_index_m, len(que)):  
            if que[i][0] < (focused_mz - tol):  
                continue  
            elif (focused_mz - tol) <= que[i][0] < (focused_mz + tol):  
                sum_m += que[i][1]  
            else:  
                remaind_index_m = i  
                break  

        # 计算理论质谱在当前m/z范围内的强度  
        sum_r = 0  
        for i in range(remaind_index_l, len(ref)):  
            if ref[i][0] < focused_mz - tol:  
                continue  
            elif (focused_mz - tol) <= ref[i][0] < (focused_mz + tol):  
                sum_r += ref[i][1]  
            else:  
                remaind_index_l = i  
                break  

        # 存储当前m/z的强度  
        measured_mass_list.append([focused_mz, sum_m])  
        reference_mass_list.append([focused_mz, sum_r])  
        
        # 更新基准强度  
        base_m = max(base_m, sum_m)  
        base_r = max(base_r, sum_r)  

        # 确定下一个聚焦的m/z  
        if focused_mz + tol > max(que[-1][0], ref[-1][0]):  
            break  
            
        if focused_mz + tol > ref[remaind_index_l][0] and focused_mz + tol <= que[remaind_index_m][0]:  
            focused_mz = que[remaind_index_m][0]  
        elif focused_mz + tol <= ref[remaind_index_l][0] and focused_mz + tol > que[remaind_index_m][0]:  
            focused_mz = ref[remaind_index_l][0]  
        else:  
            focused_mz = min(que[remaind_index_m][0], ref[remaind_index_l][0])  

    if (base_m == 0) or (base_r == 0):  
        return 0  # 返回0表示没有有效的相似性  

    sum_measure = 0  # 实验质谱的归一化强度总和  
    sum_reference = 0  # 理论质谱的归一化强度总和  
    e_spectrum_counter = 0  # 实验质谱中有效峰的计数  
    l_spectrum_counter = 0  # 理论质谱中有效峰的计数  

    # 归一化并计算有效峰计数  
    for i in range(len(measured_mass_list)):  
        measured_mass_list[i][1] /= base_m  
        reference_mass_list[i][1] /= base_r  
        sum_measure += measured_mass_list[i][1]  
        sum_reference += reference_mass_list[i][1]  

        if measured_mass_list[i][1] > 0.1:  
            e_spectrum_counter += 1  
        if reference_mass_list[i][1] > 0.1:  
            l_spectrum_counter += 1  

    # 峰计数惩罚因子  
    peak_count_penalty = 1.0  
    if l_spectrum_counter == 1:  
        peak_count_penalty = 0.75  
    elif l_spectrum_counter == 2:  
        peak_count_penalty = 0.88  
    elif l_spectrum_counter == 3:  
        peak_count_penalty = 0.94  
    elif l_spectrum_counter == 4:  
        peak_count_penalty = 0.97  

    # 计算权重  
    w_m = 0 if sum_measure - 0.5 == 0 else 1 / (sum_measure - 0.5)  
    w_r = 0 if sum_reference - 0.5 == 0 else 1 / (sum_reference - 0.5)  

    cutoff = 0.01  # 强度阈值  
    for i in range(len(measured_mass_list)):  
        if measured_mass_list[i][1] < cutoff:  
            continue  

        # 计算点积  
        scalar_m += measured_mass_list[i][1] * measured_mass_list[i][0]  
        scalar_r += reference_mass_list[i][1] * reference_mass_list[i][0]  
        covariance += np.sqrt(measured_mass_list[i][1] * reference_mass_list[i][1]) * measured_mass_list[i][0]  

    if (scalar_m == 0) or (scalar_r == 0):
        return 0  # 返回0表示没有有效的相似性  
    else:
        # 返回归一化的相似度得分  
        return (covariance ** 2) / (scalar_m * scalar_r) * peak_count_penalty


def get_cosine(que, ref, tol=0.005, tol_type='Da'):  
    """  
    与get_scores中cosine得分一致
    计算修改的点积得分。
        算法原理：计算修改的点积得分，利用匹配峰的强度来计算相似度得分，通过对强度进行加权，使得得分更加精准。
        适用于需要高度精确的数据分析，以及在大型数据集和复杂样本中寻找微小差异时。

    优点：
        通过加权和归一化，能够较好地平衡强度的影响，在得到高相似度时更可信。
        可以细致地调整质量容忍度，从而优化结果。
    缺点：
        计算复杂度相较其他方法更高，需要更多的计算资源。
        不适用于所有类型的质谱数据，特别是数据噪声较大的情况。  

    参数:  
        que (list of list of float): 实验质谱，其中第一行包含母离子的 [m/z, Intensity]，  
                                    后续行包含碎片离子的 [m/z, Intensity]。  
        ref (list of list of float): 理论质谱，其中第一行包含母离子的 [m/z, Intensity]，  
                                    后续行包含碎片离子的 [m/z, Intensity]。  
        tol (float): 质量容忍度，默认值为 0.05。  
        tol_type (str): 质量容忍度的类型，默认值为 'Da'。  

    返回:  
        list: 包含得分和匹配峰计数的列表。  
    """  
    matched_peaks = []  # 存储匹配的峰  

    # 提取母离子和碎片离子  
    que_mother = que[0]  
    ref_mother = ref[0]  
    que_fragments = que[1:]  # 获取实验的碎片离子  
    ref_fragments = ref[1:]  # 获取理论的碎片离子  

    # 设置质量容忍度  
    mass_tol = tol if tol_type == 'Da' else (ref_mother[0] * tol) / 1e6  
    
    # 检查母离子的匹配  
    if abs(que_mother[0] - ref_mother[0]) < mass_tol:  
        # 对于参考峰，遍历每个理论碎片峰  
        for r_peak in ref_fragments:  
            r_mz, r_intensity = r_peak  
            # 遍历实验碎片峰以查找匹配  
            for e_peak in que_fragments:  
                e_mz, e_intensity = e_peak  

                # 检查直接匹配（产物离子）  
                if abs(e_mz - r_mz) < mass_tol:  
                    matched_peaks.append({  
                        'Mass': r_mz,  
                        'Intensity': r_intensity,  
                        'MatchedIntensity': e_intensity,  
                        'IsProductIonMatched': True,  
                        'IsNeutralLossMatched': False  
                    })  

                # 检查中性损失匹配  
                elif abs((ref_mother[0] - que_mother[0]) + e_mz - r_mz) < mass_tol:  
                    matched_peaks.append({  
                        'Mass': r_mz,  
                        'Intensity': r_intensity,  
                        'MatchedIntensity': e_intensity,  
                        'IsProductIonMatched': False,  
                        'IsNeutralLossMatched': True  
                    })  

    # 如果没有找到匹配的峰，返回 [0, 0]  
    if len(matched_peaks) == 0:  
        return 0 

    # 计算修改的点积得分  
    product = sum(n['Intensity'] * n['MatchedIntensity'] for n in matched_peaks)  
    scaler1 = sum(n['Intensity'] ** 2 for n in matched_peaks)  
    scaler2 = sum(n['MatchedIntensity'] ** 2 for n in matched_peaks)  

    score = product / (math.sqrt(scaler1) * math.sqrt(scaler2))  # 计算得分  
    return score  


def get_matched_peaks_scores(que, ref, tol=0.005, mass_begin=100, mass_end=1000):  
    """
    ! always return 0 !  
    计算两个质谱中匹配的峰的得分。 
    算法原理： 计算实验质谱与理论质谱中的匹配峰的得分。通过量化匹配的峰数量以及它们的强度与库强度的比例来生成得分。
        非常适合在进行目标化或验证性分析时使用，比如对已知分子或目标化合物进行确认。

    优点：
        明确地只侧重于匹配的峰，提供了更具针对性的得分。
        适应性好，可以根据实际数据集的特性进行调整。
    缺点：
        仅当存在匹配峰时才有用，可能导致相似度评估不全面。
        对于少量有效峰的处理可能导致分数波动较大。 

    参数:  
        que (list of list of float): 第一个质谱（实验获得的MS/MS图谱），每个元素为[m/z, 强度]。  
        ref (list of list of float): 第二个质谱（理论上的MS/MS图谱），每个元素为[m/z, 强度]。  
        tol (float): 用于合并强度的质量窗口大小, unit Da  
        mass_begin (float): 进行计算的质量范围起始值。  
        mass_end (float): 进行计算的质量范围结束值。  

    返回:  
        tuple: 包含两个元素的元组，分别为匹配的得分和峰计数。  
    """  
    if (len(que) == 0) or (len(ref)==0) or (que is None) or (ref is None):
        return -1  # 如果任何一个质谱为空，返回-1，-1  

    sum_m = 0  
    sum_l = 0  
    min_mz = ref[0][0]  
    max_mz = ref[-1][0]  

    if mass_begin > min_mz:  
        min_mz = mass_begin  
    if max_mz > mass_end:  
        max_mz = mass_end  

    focused_mz = min_mz  
    max_lib_intensity = max(ref, key=lambda x: x[1])[1]  
    remaind_index_m = 0  
    remaind_index_l = 0  
    counter = 0  
    lib_counter = 0  

    while focused_mz <= max_mz:  
        sum_l = 0  
        for i in range(remaind_index_l, len(ref)):  
            if ref[i][0] < focused_mz - tol:  
                continue  
            elif focused_mz - tol <= ref[i][0] < focused_mz + tol:  
                sum_l += ref[i][1]  
            else:  
                remaind_index_l = i  
                break  

        # 检查库强度是否达到阈值  
        if sum_l >= (0.01 * max_lib_intensity):  
            lib_counter += 1  

        sum_m = 0  
        for i in range(remaind_index_m, len(que)):  
            if que[i][0] < (focused_mz - tol):  
                continue  
            elif (focused_mz - tol) <= que[i][0] < (focused_mz + tol):  
                sum_m += que[i][1]  
            else:  
                remaind_index_m = i  
                break  

        if (sum_m > 0) and (sum_l >= (0.01 * max_lib_intensity)):  
            counter += 1  

        if focused_mz + tol > ref[-1][0]:  
            break  

        focused_mz = ref[remaind_index_l][0]  

    if lib_counter == 0:  
        return 0 
    else:  
        return counter / lib_counter


def get_reverse_dot_product(que, ref, tol=0.005, mass_begin=100, mass_end=1000):  
    """  
    ! always return 0 !  
    计算两个质谱之间的反向点积相似度。 
    算法原理： 计算质谱之间的反向点积相似度，基于反向比较的思路，主要是通过使用反向理论质谱数据计算相似度。
        有助于寻找低浓度组分的相似性时，特别是在较大数据集中，反向点积可能会揭示不同的相似性。
    优点：
        结合了反向比较，可以使其在某些情况下更有效，比如在噪音背景中。
        可以确保反向点积提供新的相似性视角。
    缺点：
        同样容易受到底噪的影响。
        对于某些数据集可能没有明显优势。 
    参数:  
        que (list of list of float): 第一个质谱（实验获得的MS/MS图谱），每个元素为[m/z, 强度]。  
        ref (list of list of float): 第二个质谱（理论上的MS/MS图谱），每个元素为[m/z, 强度]。  
        tol (float): 用于合并强度的质量窗口大小。  
        mass_begin (float): 进行计算的质量范围起始值。  
        mass_end (float): 进行计算的质量范围结束值。  

    返回:  
    float: 归一化的相似度得分，范围从0（没有相似性）到1（完全一致）。  
    """  
    scalar_m = 0  
    scalar_r = 0  
    covariance = 0  
    sum_m = 0  
    sum_l = 0  

    if (len(que) == 0) or (len(ref) == 0):  
        return -1  # 如果任一一个质谱为空，返回-1  

    min_mz = ref[0][0]  
    max_mz = ref[-1][0]  

    if mass_begin > min_mz:  
        min_mz = mass_begin  
    if max_mz > mass_end:  
        max_mz = mass_end  

    focused_mz = min_mz  
    remaind_index_m = 0  
    remaind_index_l = 0  
    counter = 0  

    measured_mass_buffer = []  
    reference_mass_buffer = []  
    size = 0  

    base_m = float('-inf')  
    base_r = float('-inf')  

    while focused_mz <= max_mz:  
        sum_l = 0  
        for i in range(remaind_index_l, len(ref)):  
            if ref[i][0] < focused_mz - tol:  
                continue  
            elif focused_mz - tol <= ref[i][0] < focused_mz + tol:  
                sum_l += ref[i][1]  
            else:  
                remaind_index_l = i  
                break  

        sum_m = 0  
        for i in range(remaind_index_m, len(que)):  
            if que[i][0] < focused_mz - tol:  
                continue  
            elif focused_mz - tol <= que[i][0] < focused_mz + tol:  
                sum_m += que[i][1]  
            else:  
                remaind_index_m = i  
                break  

        # 存储当前质量的强度  
        measured_mass_buffer.append((focused_mz, sum_m))  
        if sum_m > base_m:  
            base_m = sum_m  
        
        reference_mass_buffer.append((focused_mz, sum_l))  
        if sum_l > base_r:  
            base_r = sum_l  

        if sum_m > 0:  
            counter += 1  

        size += 1  

        if focused_mz + tol > ref[-1][0]:  
            break  
        focused_mz = ref[remaind_index_l][0]  

    if (base_m == 0) or (base_r == 0):  
        return 0  

    e_spectrum_counter = 0  
    l_spectrum_counter = 0  
    sum_measure = 0  
    sum_reference = 0  

    for i in range(size):  
        mz_m, intensity_m = measured_mass_buffer[i]  
        mz_r, intensity_r = reference_mass_buffer[i]  
        intensity_m /= base_m  
        intensity_r /= base_r  
        measured_mass_buffer[i] = (mz_m, intensity_m)  
        reference_mass_buffer[i] = (mz_r, intensity_r)  
        
        sum_measure += intensity_m  
        sum_reference += intensity_r  

        if intensity_m > 0.1:  
            e_spectrum_counter += 1  
        if intensity_r > 0.1:  
            l_spectrum_counter += 1  

    # 峰计数惩罚因子  
    peak_count_penalty = 1.0  
    if l_spectrum_counter == 1:  
        peak_count_penalty = 0.75  
    elif l_spectrum_counter == 2:  
        peak_count_penalty = 0.88  
    elif l_spectrum_counter == 3:  
        peak_count_penalty = 0.94  
    elif l_spectrum_counter == 4:  
        peak_count_penalty = 0.97  

    w_m = 0 if sum_measure - 0.5 == 0 else 1 / (sum_measure - 0.5)  
    w_r = 0 if sum_reference - 0.5 == 0 else 1 / (sum_reference - 0.5)  

    cutoff = 0.01  

    for i in range(size):  
        mz_m, intensity_m = measured_mass_buffer[i]  
        mz_r, intensity_r = reference_mass_buffer[i]  

        if intensity_r < cutoff:  
            continue  

        scalar_m += intensity_m * mz_m  
        scalar_r += intensity_r * mz_r  
        covariance += np.sqrt(intensity_m * intensity_r) * mz_m  

    if (scalar_m == 0) or (scalar_r == 0):  
        return 0  
    else:  
        return (covariance ** 2) / (scalar_m * scalar_r) * peak_count_penalty  


def get_simple_dot_product(que, ref, tol=0.005, mass_begin=100, mass_end=1000):  
    """  
    计算质谱之间的简单点积相似度。  
    算法原理: 计算质谱间的简单点积相似度，基于将质谱按一定质量窗口聚合后的归一化强度。
        适合快速估算样本间的相似度，尤其是在需要对大量数据快速筛选时。

    优点：
        方法简单直接，容易理解和实现。
        快速聚合与计算，无需复杂的惩罚因子或额外计算。
    缺点：
        对噪声和底噪敏感，可能会导致不准确的相似度得分。
        忽视了匹配峰的个数和强度，因此对于相似度的描述不够全面。

    参数:  
        que (list of list of float): 实验质谱数据，每个元素为[m/z, 强度]。  
        ref (list of list of float): 理论质谱数据，每个元素为[m/z, 强度]。  
        tol (float, optional): 定义合并强度的质量窗口大小, 默认为 0.005。  
        mass_begin (float, optional): 计算的质量范围起始值, 默认为 100。  
        mass_end (float, optional): 计算的质量范围结束值, 默认为 1000。  

    返回:  
        float: 返回相似度分数，值为0表示无相似度，值越大表示相似度越高。  
    """  
    scalar_m = 0  
    scalar_r = 0  
    covariance = 0  
    sum_m = 0  
    sum_r = 0  

    if len(que) == 0:  
        return 0  
    if len(ref) == 0:  
        return 0  

    # 更新为访问二维列表的方式  
    min_mz = min(que[0][0], ref[0][0])  
    max_mz = max(que[-1][0], ref[-1][0])  
    focused_mz = min_mz  
    remaind_index_m = 0  
    remaind_index_l = 0  

    if mass_begin > min_mz:  
        min_mz = mass_begin  
    if max_mz > mass_end:  
        max_mz = mass_end  

    measured_mass_list = []  
    reference_mass_list = []  

    base_m = float('-inf')  
    base_r = float('-inf')  

    while focused_mz <= max_mz:  
        # 计算实验质谱在当前聚焦质量的强度  
        sum_m = 0  
        for i in range(remaind_index_m, len(que)):  
            if que[i][0] < focused_mz - tol:  
                continue  
            elif focused_mz - tol <= que[i][0] < focused_mz + tol:  
                sum_m += que[i][1]  
            else:  
                remaind_index_m = i  
                break  

        # 计算理论质谱在当前聚焦质量的强度  
        sum_r = 0  
        for i in range(remaind_index_l, len(ref)):  
            if ref[i][0] < focused_mz - tol:  
                continue  
            elif focused_mz - tol <= ref[i][0] < focused_mz + tol:  
                sum_r += ref[i][1]  
            else:  
                remaind_index_l = i  
                break  

        # 添加当前聚焦质量的强度到列表中  
        measured_mass_list.append([focused_mz, sum_m])  
        reference_mass_list.append([focused_mz, sum_r])  
        
        if sum_m > base_m:  
            base_m = sum_m  
        if sum_r > base_r:  
            base_r = sum_r  

        # 更新聚焦质量  
        if (focused_mz + tol) > max(que[-1][0], ref[-1][0]):  
            break  

        
        if focused_mz + tol > ref[remaind_index_l][0] and focused_mz + tol <= que[remaind_index_m][0]:  
            focused_mz = que[remaind_index_m][0]  
        elif focused_mz + tol <= ref[remaind_index_l][0] and focused_mz + tol > que[remaind_index_m][0]:  
            focused_mz = ref[remaind_index_l][0]  
        else:  
            focused_mz = min(que[remaind_index_m][0], ref[remaind_index_l][0])  

    if base_m == 0 or base_r == 0:  
        return 0  

    # 归一化  
    for i in range(len(measured_mass_list)):  
        measured_mass_list[i][1] = (measured_mass_list[i][1] / base_m) * 999  
        reference_mass_list[i][1] = (reference_mass_list[i][1] / base_r) * 999  

    # 计算点积和协方差  
    for i in range(len(measured_mass_list)):  
        scalar_m += measured_mass_list[i][1]  
        scalar_r += reference_mass_list[i][1]  
        covariance += np.sqrt(measured_mass_list[i][1] * reference_mass_list[i][1])  

    if (scalar_m == 0) or (scalar_r == 0):  
        return 0  
    else:  
        return (covariance ** 2) / (scalar_m * scalar_r)



